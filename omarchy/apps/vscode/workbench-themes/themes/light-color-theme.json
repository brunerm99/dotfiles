  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#243239",
    "parameter": "#243239",
    "function": "#195b7a",
    "method": "#195b7a",
    "type": "#205b6c",
    "class": "#205b6c",
    "keyword": "#694497",
    "string": "#176032",
    "number": "#774917"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#46585e"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#176032"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#774917"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#914312"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#694497"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#694497"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#195b7a"
      }
    },
    {
      "scope": "support.function",
      "settings": {
        "foreground": "#195b7a"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#205b6c"
      }
    },
    {
      "scope": "support.type",
      "settings": {
        "foreground": "#205b6c"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#243239"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#46585e"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#914312"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#176032"
      }
    }
  ]
}
