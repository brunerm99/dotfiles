  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#2d3e44",
    "parameter": "#2d3e44",
    "function": "#1e698d",
    "method": "#1e698d",
    "type": "#24697d",
    "class": "#24697d",
    "keyword": "#7950ac",
    "string": "#1b733c",
    "number": "#8d561b"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#5a6f76"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#1b733c"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#8d561b"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#a74e15"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#7950ac"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#7950ac"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#1e698d"
      }
    },
    {
      "scope": "support.function",
      "settings": {
        "foreground": "#1e698d"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#24697d"
      }
    },
    {
      "scope": "support.type",
      "settings": {
        "foreground": "#24697d"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#2d3e44"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#5a6f76"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#a74e15"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#1b733c"
      }
    }
  ]
}
