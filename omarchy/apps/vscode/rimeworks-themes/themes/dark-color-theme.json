    "type": "#50dbc8",
    "class": "#50dbc8",
    "keyword": "#a87edb",
    "string": "#44d47a",
    "number": "#e0a050"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#8fa3ab"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#44d47a"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#e0a050"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#f09050"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#a87edb"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#a87edb"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#58c4dd"
      }
    },
    {
      "scope": "support.function",
      "settings": {
        "foreground": "#58c4dd"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#50dbc8"
      }
    },
    {
      "scope": "support.type",
      "settings": {
        "foreground": "#50dbc8"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#d4d0cc"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#8fa3ab"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#f09050"
      }
    },
    {
      "scope": "markup.inline.raw",
