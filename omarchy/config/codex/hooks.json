{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^view_image$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/codex/hooks/open-viewed-image.py\"",
            "timeout": 5,
            "statusMessage": "Opening viewed image"
          }
        ]
      }
    ]
  }
}
