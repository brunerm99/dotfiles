# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Font
font-family = "IBM Plex Mono"
font-style = Regular
font-size = 11
command = /usr/bin/fish

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat
gtk-wide-tabs = false
gtk-custom-css = ~/.config/ghostty/tabs.css

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# Terminal preferences from dotfiles/kitty.
font-feature = -calt

# Workbench cursor and focused-pane outline.
cursor-opacity = 1
adjust-cursor-thickness = 2
unfocused-split-opacity = 1
custom-shader = ~/.config/ghostty/shaders/workbench-focus.glsl
custom-shader-animation = false

# Personal bindings from ~/.dotfiles (machine/kraken).
copy-on-select = clipboard
keybind = shift+enter=text:\x1b\r
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down
keybind = alt+n=new_split:auto
keybind = alt+o=new_split:right
keybind = ctrl+alt+o=new_split:left
keybind = alt+e=new_split:down
keybind = ctrl+alt+e=new_split:up
keybind = alt+f=toggle_split_zoom
keybind = alt+t=new_tab
keybind = alt+f4=unbind
keybind = alt+,=jump_to_prompt:-1
keybind = alt+.=jump_to_prompt:1
keybind = alt+/=toggle_tab_overview
keybind = alt+i=toggle_quick_terminal
