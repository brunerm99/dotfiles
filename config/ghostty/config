# style

font-family = "Maple Mono CN"

palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5
background = #1a1b26
foreground = #c0caf5
cursor-color = #c0caf5
cursor-text = #15161e
selection-background = #33467c
selection-foreground = #c0caf5

# keyboard

copy-on-select = clipboard

keybind = shift+enter=text:\x1b\r

keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down
keybind = alt+n=new_split:auto
keybind = alt+o=new_split:right
keybind = alt+e=new_split:down
keybind = alt+f=toggle_split_zoom
keybind = alt+t=new_tab
keybind = alt+f4=unbind

keybind = alt+,=jump_to_prompt:-1
keybind = alt+.=jump_to_prompt:1

keybind = alt+/=toggle_tab_overview
keybind = alt+i=toggle_quick_terminal
