#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/group-stacks"
mkdir -p "$state_dir"

dispatch() {
    hyprctl dispatch "$1" >/dev/null
}

layout_message() {
    dispatch "hl.dsp.layout(\"$1\")"
}

focus_workspace() {
    local workspace="$1"
    dispatch "hl.dsp.focus({ workspace = \"${workspace}\" })"
}

focus_window() {
    local address="$1"
    dispatch "hl.dsp.focus({ window = \"address:${address}\" })"
}

workspace_json="$(hyprctl -j activeworkspace)"
workspace_name="$(jq -r '.name // empty' <<<"$workspace_json")"

if [[ -z "$workspace_name" ]]; then
    exit 1
fi

state_id="$(printf '%s' "$workspace_name" | tr -c 'A-Za-z0-9_.-' '_')"
state_file="${state_dir}/${state_id}.tsv"

workspace_clients() {
    hyprctl -j clients |
        jq --arg workspace "$workspace_name" '
            [
                .[]
                | select(.workspace.name == $workspace and (.floating | not) and (.pinned | not))
                | . + {
                    groupKey: (if (.grouped | length) > 1 then (.grouped | join(",")) else .address end)
                  }
            ]
        '
}

current_tiles() {
    jq '
        group_by(.groupKey)
        | map(
            (map(select(.visible)) | .[0]) // .[0]
            | {
                key: .groupKey,
                address,
                x: .at[0],
                y: .at[1],
                w: .size[0],
                h: .size[1],
                cx: (.at[0] + (.size[0] / 2)),
                cy: (.at[1] + (.size[1] / 2)),
                groupSize: (.grouped | length)
              }
          )
    '
}

direction_to_anchor() {
    local target_cx="$1"
    local target_cy="$2"
    local anchor_cx="$3"
    local anchor_cy="$4"

    jq -nr \
        --argjson target_cx "$target_cx" \
        --argjson target_cy "$target_cy" \
        --argjson anchor_cx "$anchor_cx" \
        --argjson anchor_cy "$anchor_cy" '
            ($anchor_cx - $target_cx) as $dx
            | ($anchor_cy - $target_cy) as $dy
            | if (($dx | fabs) >= ($dy | fabs)) then
                if $dx >= 0 then "r" else "l" end
              else
                if $dy >= 0 then "d" else "u" end
              end
        '
}

original_side() {
    local target_cx="$1"
    local target_cy="$2"
    local anchor_cx="$3"
    local anchor_cy="$4"

    jq -nr \
        --argjson target_cx "$target_cx" \
        --argjson target_cy "$target_cy" \
        --argjson anchor_cx "$anchor_cx" \
        --argjson anchor_cy "$anchor_cy" '
            ($target_cx - $anchor_cx) as $dx
            | ($target_cy - $anchor_cy) as $dy
            | if (($dx | fabs) >= ($dy | fabs)) then
                if $dx <= 0 then "l" else "r" end
              else
                if $dy <= 0 then "u" else "d" end
              end
        '
}

restore_plan() {
    local anchor_address="$1"
    shift

    printf '%s\n' "$@" |
        jq -r -R -s --arg anchor "$anchor_address" '
            def to_tiles:
                split("\n")
                | map(select(length > 0) | split("\t"))
                | map({
                    address: .[0],
                    x: (.[1] | tonumber),
                    y: (.[2] | tonumber),
                    w: (.[3] | tonumber),
                    h: (.[4] | tonumber)
                  });

            def right: .x + .w;
            def bottom: .y + .h;

            def bounds($items):
                {
                    x: ($items | map(.x) | min),
                    y: ($items | map(.y) | min),
                    r: ($items | map(right) | max),
                    b: ($items | map(bottom) | max)
                }
                | . + { w: (.r - .x), h: (.b - .y) };

            def split_candidates($items):
                bounds($items) as $b
                | (
                    [
                        $items[]
                        | right as $edge
                        | select($edge > $b.x and $edge < $b.r)
                        | $edge
                    ]
                    | unique
                    | map(
                        . as $edge
                        | ($items | map(select(right <= ($edge + 2)))) as $left
                        | ($items | map(select(.x >= ($edge - 2)))) as $right
                        | select(
                            ($left | length) > 0
                            and ($right | length) > 0
                            and (($left | length) + ($right | length) == ($items | length))
                          )
                        | (($left | map(right) | max) + ($right | map(.x) | min)) / 2 as $boundary
                        | {
                            axis: "v",
                            first: $left,
                            second: $right,
                            ratio: ((2 * ($boundary - $b.x) / $b.w) | if . < 0.1 then 0.1 elif . > 1.9 then 1.9 else . end)
                          }
                    )
                ) + (
                    [
                        $items[]
                        | bottom as $edge
                        | select($edge > $b.y and $edge < $b.b)
                        | $edge
                    ]
                    | unique
                    | map(
                        . as $edge
                        | ($items | map(select(bottom <= ($edge + 2)))) as $top
                        | ($items | map(select(.y >= ($edge - 2)))) as $bottom
                        | select(
                            ($top | length) > 0
                            and ($bottom | length) > 0
                            and (($top | length) + ($bottom | length) == ($items | length))
                          )
                        | (($top | map(bottom) | max) + ($bottom | map(.y) | min)) / 2 as $boundary
                        | {
                            axis: "h",
                            first: $top,
                            second: $bottom,
                            ratio: ((2 * ($boundary - $b.y) / $b.h) | if . < 0.1 then 0.1 elif . > 1.9 then 1.9 else . end)
                          }
                    )
                );

            def abs: if . < 0 then -. else . end;

            def build($items):
                if ($items | length) == 1 then
                    { type: "leaf", address: $items[0].address }
                else
                    (split_candidates($items) | sort_by(((.first | length) - (.second | length) | abs)) | .[0]) as $split
                    | if $split == null then
                        ($items | sort_by(.x, .y)) as $sorted
                        | {
                            type: "split",
                            axis: "v",
                            ratio: 1,
                            first: build([$sorted[0]]),
                            second: build($sorted[1:])
                          }
                      else
                        {
                            type: "split",
                            axis: $split.axis,
                            ratio: $split.ratio,
                            first: build($split.first),
                            second: build($split.second)
                          }
                      end
                end;

            def contains($node; $address):
                if $node.type == "leaf" then
                    $node.address == $address
                else
                    contains($node.first; $address) or contains($node.second; $address)
                end;

            def first_leaf($node):
                if $node.type == "leaf" then
                    $node.address
                else
                    first_leaf($node.first)
                end;

            def direction($axis; $from_first):
                if $axis == "v" then
                    if $from_first then "r" else "l" end
                else
                    if $from_first then "d" else "u" end
                end;

            def plan($node; $rep):
                if $node.type == "leaf" then
                    []
                else
                    (contains($node.first; $rep)) as $rep_in_first
                    | if $rep_in_first then
                        (first_leaf($node.second)) as $other
                        | [
                            {
                                focus: $rep,
                                direction: direction($node.axis; true),
                                address: $other,
                                ratio: $node.ratio
                            }
                          ]
                          + plan($node.first; $rep)
                          + plan($node.second; $other)
                      else
                        (first_leaf($node.first)) as $other
                        | [
                            {
                                focus: $rep,
                                direction: direction($node.axis; false),
                                address: $other,
                                ratio: $node.ratio
                            }
                          ]
                          + plan($node.second; $rep)
                          + plan($node.first; $other)
                      end
                end;

            (to_tiles) as $tiles
            | if ($tiles | length) <= 1 then
                empty
              else
                (build($tiles)) as $tree
                | ($anchor as $preferred | if contains($tree; $preferred) then $preferred else first_leaf($tree) end) as $rep
                | plan($tree; $rep)[]
                | [.focus, .direction, .address, (.ratio | tostring)]
                | @tsv
              end
        '
}

restore_from_tiles() {
    local anchor_address="$1"
    shift

    local plan
    plan="$(restore_plan "$anchor_address" "$@")"

    [[ -z "$plan" ]] && return 0

    while IFS=$'\t' read -r focus_address direction address _ratio; do
        [[ -z "$focus_address" || -z "$address" || -z "$direction" ]] && continue

        focus_window "$focus_address" || true
        layout_message "preselect ${direction}" || true
        dispatch "hl.dsp.window.move({ out_of_group = true, window = \"address:${address}\" })" || true
    done <<<"$plan"
}

restore_from_legacy_moves() {
    local moved_lines=("$@")

    for ((i = ${#moved_lines[@]} - 1; i >= 0; i--)); do
        IFS=$'\t' read -r address restore_direction <<<"${moved_lines[$i]}"
        [[ -z "$address" ]] && continue

        focus_window "$address" || continue
        dispatch 'hl.dsp.window.move({ out_of_group = true })' || true

        if [[ -n "$restore_direction" ]]; then
            dispatch "hl.dsp.window.move({ direction = \"${restore_direction}\" })" || true
        fi
    done
}

ungroup_workspace() {
    local anchor_address=""
    local created_anchor_group="0"
    local active_address=""
    local active_fullscreen="0"
    local moved_lines=()
    local tile_lines=()

    while IFS=$'\t' read -r kind arg1 arg2 arg3 arg4 arg5; do
        case "$kind" in
            anchor) anchor_address="$arg1" ;;
            created_anchor_group) created_anchor_group="$arg1" ;;
            active) active_address="$arg1" ;;
            active_fullscreen) active_fullscreen="$arg1" ;;
            moved) moved_lines+=("${arg1}"$'\t'"${arg2}") ;;
            tile) tile_lines+=("${arg1}"$'\t'"${arg2}"$'\t'"${arg3}"$'\t'"${arg4}"$'\t'"${arg5}") ;;
        esac
    done < "$state_file"

    local current_active_json
    current_active_json="$(hyprctl -j activewindow)"
    if [[ "$(jq -r '.workspace.name // empty' <<<"$current_active_json")" == "$workspace_name" ]]; then
        active_address="$(jq -r '.address // empty' <<<"$current_active_json")"
        active_fullscreen="$(jq -r '.fullscreen // 0' <<<"$current_active_json")"
    fi

    focus_workspace "$workspace_name"

    if [[ "${#tile_lines[@]}" -gt 0 && -n "$anchor_address" ]]; then
        restore_from_tiles "$anchor_address" "${tile_lines[@]}"
    else
        restore_from_legacy_moves "${moved_lines[@]}"
    fi

    if [[ "$created_anchor_group" == "1" && -n "$anchor_address" ]]; then
        focus_window "$anchor_address" || true
        dispatch 'hl.dsp.group.toggle()' || true
    fi

    rm -f "$state_file"

    if [[ -n "$active_address" ]]; then
        focus_window "$active_address" || true
        if [[ "$active_fullscreen" != "0" ]]; then
            local current_fullscreen
            current_fullscreen="$(hyprctl -j activewindow | jq -r '.fullscreen // 0')"
            if [[ "$current_fullscreen" == "0" ]]; then
                dispatch 'hl.dsp.window.fullscreen({ action = "toggle" })' || true
            fi
        fi
    fi

}

group_workspace() {
    local clients_json
    local tiles_json
    local tile_count
    clients_json="$(workspace_clients)"
    tiles_json="$(current_tiles <<<"$clients_json")"
    tile_count="$(jq 'length' <<<"$tiles_json")"

    if [[ "$tile_count" -le 1 ]]; then
        return
    fi

    local active_address
    local active_fullscreen
    local active_key
    local anchor_json
    local active_window_json
    active_window_json="$(hyprctl -j activewindow)"
    active_address="$(jq -r '.address // empty' <<<"$active_window_json")"
    active_fullscreen="$(jq -r '.fullscreen // 0' <<<"$active_window_json")"
    active_key="$(
        jq -r --arg address "$active_address" '
            map(select(.address == $address)) | .[0].groupKey // empty
        ' <<<"$clients_json"
    )"

    if [[ -n "$active_key" ]]; then
        anchor_json="$(jq --arg key "$active_key" 'map(select(.key == $key and .groupSize > 1)) | .[0] // empty' <<<"$tiles_json")"
    else
        anchor_json=""
    fi

    if [[ -z "$anchor_json" || "$anchor_json" == "null" ]]; then
        anchor_json="$(jq 'map(select(.groupSize > 1)) | .[0] // empty' <<<"$tiles_json")"
    fi

    if [[ -z "$anchor_json" || "$anchor_json" == "null" ]]; then
        if [[ -n "$active_key" ]]; then
            anchor_json="$(jq --arg key "$active_key" 'map(select(.key == $key)) | .[0] // empty' <<<"$tiles_json")"
        fi
    fi

    if [[ -z "$anchor_json" || "$anchor_json" == "null" ]]; then
        anchor_json="$(jq '.[0]' <<<"$tiles_json")"
    fi

    local anchor_key
    local anchor_address
    local anchor_cx
    local anchor_cy
    local anchor_group_size
    anchor_key="$(jq -r '.key' <<<"$anchor_json")"
    anchor_address="$(jq -r '.address' <<<"$anchor_json")"
    anchor_cx="$(jq -r '.cx' <<<"$anchor_json")"
    anchor_cy="$(jq -r '.cy' <<<"$anchor_json")"
    anchor_group_size="$(jq -r '.groupSize' <<<"$anchor_json")"

    local created_anchor_group="0"
    focus_window "$anchor_address"
    if [[ "$anchor_group_size" -le 1 ]]; then
        dispatch 'hl.dsp.group.toggle()'
        created_anchor_group="1"
    fi

    local tmp_file="${state_file}.tmp"
    {
        printf 'workspace\t%s\n' "$workspace_name"
        printf 'anchor\t%s\n' "$anchor_address"
        printf 'created_anchor_group\t%s\n' "$created_anchor_group"
        printf 'active\t%s\n' "$active_address"
        printf 'active_fullscreen\t%s\n' "$active_fullscreen"
        jq -r '.[] | ["tile", .address, .x, .y, .w, .h] | @tsv' <<<"$tiles_json"
    } > "$tmp_file"

    while IFS=$'\t' read -r address target_cx target_cy; do
        [[ -z "$address" ]] && continue

        local into_direction
        local restore_direction
        into_direction="$(direction_to_anchor "$target_cx" "$target_cy" "$anchor_cx" "$anchor_cy")"
        restore_direction="$(original_side "$target_cx" "$target_cy" "$anchor_cx" "$anchor_cy")"

        focus_window "$address"
        dispatch "hl.dsp.window.move({ into_group = \"${into_direction}\" })"
        printf 'moved\t%s\t%s\n' "$address" "$restore_direction" >> "$tmp_file"
    done < <(
        jq -r --arg anchor_key "$anchor_key" '
            .[]
            | select(.key != $anchor_key)
            | [.address, .cx, .cy]
            | @tsv
        ' <<<"$tiles_json"
    )

    mv "$tmp_file" "$state_file"

    if [[ -n "$active_address" ]]; then
        focus_window "$active_address" || true
        if [[ "$active_fullscreen" != "0" ]]; then
            local current_fullscreen
            current_fullscreen="$(hyprctl -j activewindow | jq -r '.fullscreen // 0')"
            if [[ "$current_fullscreen" == "0" ]]; then
                dispatch 'hl.dsp.window.fullscreen({ action = "toggle" })' || true
            fi
        fi
    fi

}

if [[ -f "$state_file" ]]; then
    ungroup_workspace
else
    group_workspace
fi
