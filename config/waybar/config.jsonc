{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "spacing": 0,
  "modules-left": [
    "custom/ws-1",
    "custom/ws-2",
    "custom/ws-3",
    "custom/ws-4",
    "custom/ws-5",
    "custom/ws-6",
    "custom/ws-7",
    "custom/ws-8",
    "custom/ws-9",
    "custom/ws-10",
    "custom/ws-11",
    "custom/ws-12",
    "custom/ws-13",
    "custom/ws-14",
    "custom/ws-15",
    "custom/ws-16",
    "custom/ws-17",
    "custom/ws-18",
    "custom/ws-19",
    "custom/ws-20",
    "tray"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "custom/brightness",
    "cpu",
    "memory",
    "bluetooth",
    "network"
  ],
  "custom/ws-1": {
    "exec": "/home/marchall/.config/waybar/scripts/workspace-button.py 1",
    "return-type": "json",
    "signal": 9,
    "hide-empty-text": true,
    "format": "{text}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
  },
